private: shifted value = @value 78 + ;
private: square value = @value @value * ;
private: left value = @value call:shifted:1 call:square:1 3 * ;
private: right value = @value call:shifted:1 5 * ;
private: step value = @value call:left:1 @value call:right:1 + 17 + ;

export: run seed rounds = @rounds @seed repeat:step ;
