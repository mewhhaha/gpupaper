private: left value = @value 3 * 17 + ;
private: right value = @value 5 * 29 - ;
private: join value = @value call:left:1 @value call:right:1 + ;
private: classify value = @value 0 < @value 101 + @value 103 - select! ;
private: rotate value = @value 9 * 7 + ;
private: finish value left_value right_value =
  @value 11 % 0 == @value @left_value + @value @right_value - select! ;
private: step value =
  @value call:left:1 let:left_value
  @value call:right:1 let:right_value
  @value call:join:1 call:classify:1 call:rotate:1
  @left_value @right_value call:finish:3 ;

export: run seed rounds = @rounds @seed repeat:step ;
