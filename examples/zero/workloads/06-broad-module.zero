fn left(value) = value * 3 + 17;
fn right(value) = value * 5 - 29;
fn join(value) = left(value) + right(value);
fn classify(value) = if value < 0 then value + 101 else value - 103;
fn rotate(value) = value * 9 + 7;
fn finish(value, left_value, right_value) =
  if value % 11 == 0 then value + left_value else value - right_value;
fn step(value) =
  let left_value = left(value) in
  let right_value = right(value) in
  finish(rotate(classify(join(value))), left_value, right_value);

export fn run(seed, rounds) =
  repeat rounds from seed as value { step(value) };
