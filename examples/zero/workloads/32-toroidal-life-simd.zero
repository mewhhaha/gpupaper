private: bit boards[i32x4] shift =>
  @boards @shift i32x4.shr_u 1 i32x4.splat i32x4.and ;

private: next_cell boards[i32x4] current northwest north northeast west east southwest south southeast =>
  @boards @current call:bit:2 let:alive
  @boards @northwest call:bit:2
  @boards @north call:bit:2 i32x4.add
  @boards @northeast call:bit:2 i32x4.add
  @boards @west call:bit:2 i32x4.add
  @boards @east call:bit:2 i32x4.add
  @boards @southwest call:bit:2 i32x4.add
  @boards @south call:bit:2 i32x4.add
  @boards @southeast call:bit:2 i32x4.add let:neighbors
  @neighbors 3 i32x4.splat i32x4.eq
  1 i32x4.splat
  @neighbors 2 i32x4.splat i32x4.eq
  @alive
  0 i32x4.splat
  i32x4.select
  i32x4.select ;

private: generation boards[i32x4] =>
  @boards 0 24 20 21 4 1 9 5 6 call:next_cell:10 0 i32x4.shl
  @boards 1 20 21 22 0 2 5 6 7 call:next_cell:10 1 i32x4.shl i32x4.add
  @boards 2 21 22 23 1 3 6 7 8 call:next_cell:10 2 i32x4.shl i32x4.add
  @boards 3 22 23 24 2 4 7 8 9 call:next_cell:10 3 i32x4.shl i32x4.add
  @boards 4 23 24 20 3 0 8 9 5 call:next_cell:10 4 i32x4.shl i32x4.add
  @boards 5 4 0 1 9 6 14 10 11 call:next_cell:10 5 i32x4.shl i32x4.add
  @boards 6 0 1 2 5 7 10 11 12 call:next_cell:10 6 i32x4.shl i32x4.add
  @boards 7 1 2 3 6 8 11 12 13 call:next_cell:10 7 i32x4.shl i32x4.add
  @boards 8 2 3 4 7 9 12 13 14 call:next_cell:10 8 i32x4.shl i32x4.add
  @boards 9 3 4 0 8 5 13 14 10 call:next_cell:10 9 i32x4.shl i32x4.add
  @boards 10 9 5 6 14 11 19 15 16 call:next_cell:10 10 i32x4.shl i32x4.add
  @boards 11 5 6 7 10 12 15 16 17 call:next_cell:10 11 i32x4.shl i32x4.add
  @boards 12 6 7 8 11 13 16 17 18 call:next_cell:10 12 i32x4.shl i32x4.add
  @boards 13 7 8 9 12 14 17 18 19 call:next_cell:10 13 i32x4.shl i32x4.add
  @boards 14 8 9 5 13 10 18 19 15 call:next_cell:10 14 i32x4.shl i32x4.add
  @boards 15 14 10 11 19 16 24 20 21 call:next_cell:10 15 i32x4.shl i32x4.add
  @boards 16 10 11 12 15 17 20 21 22 call:next_cell:10 16 i32x4.shl i32x4.add
  @boards 17 11 12 13 16 18 21 22 23 call:next_cell:10 17 i32x4.shl i32x4.add
  @boards 18 12 13 14 17 19 22 23 24 call:next_cell:10 18 i32x4.shl i32x4.add
  @boards 19 13 14 10 18 15 23 24 20 call:next_cell:10 19 i32x4.shl i32x4.add
  @boards 20 19 15 16 24 21 4 0 1 call:next_cell:10 20 i32x4.shl i32x4.add
  @boards 21 15 16 17 20 22 0 1 2 call:next_cell:10 21 i32x4.shl i32x4.add
  @boards 22 16 17 18 21 23 1 2 3 call:next_cell:10 22 i32x4.shl i32x4.add
  @boards 23 17 18 19 22 24 2 3 4 call:next_cell:10 23 i32x4.shl i32x4.add
  @boards 24 18 19 15 23 20 3 4 0 call:next_cell:10 24 i32x4.shl i32x4.add ;

export: run seed generations =
  @seed @seed 1 + @seed 65537 + @seed 1048579 + @generations call:run_boards:5 ;

export: run_boards board0 board1 board2 board3 generations =
  @board0 @board1 @board2 @board3 i32x4.make
  33554431 i32x4.splat i32x4.and let:boards
  @generations @boards repeat:generation let:result
  @result i32x4.extract_lane_0
  @result i32x4.extract_lane_1 3 * +
  @result i32x4.extract_lane_2 5 * +
  @result i32x4.extract_lane_3 7 * + ;
