module () where

const { struct } = import "duck:prelude" ()

type Box = struct { .v = Int }

duck Read Self {
  type Out
  .read = Self -> Out
}

const offset = 40

extend Box {
  type Out = Int
  .read = (b: Box) => b.v + offset
}

const make = () => {
  let b: Box = [.v = 1]
  Read.read(b)
}

return { make }
