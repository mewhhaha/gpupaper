grammar DuckContextual

token IDENTIFIER = /[A-Za-z_][A-Za-z0-9_]*/ ;
token INTEGER = /[0-9]+/ ;
skip WHITESPACE = /[ \t\r\n]+/ ;

contextual APPLICATION_SPACE = /[ \t]+(?=[A-Za-z_])(?!(as|by|else|if|in|is|where|with)\b)/ ;
contextual TYPE_APPLICATION_SPACE = /[ \t]+(?=[A-Za-z_#&]|\(|\[)/ ;
contextual BREAK_VALUE_SPACE = /[ \t]+(?=[^\r\n;}])/ ;
contextual BREAK_TERMINATOR_SPACE = /[ \t]+(?=$|[\r\n;}])/ ;
contextual EXTENSION_MEMBER_TERMINATOR = /[\r\n]/ ;

module = application_case | type_case | break_case | extension_case ;

application_case = "app:" first:application "if" second:application ;
application = head:IDENTIFIER (APPLICATION_SPACE arguments:IDENTIFIER)* ;

type_case = "type:" constructor:IDENTIFIER TYPE_APPLICATION_SPACE argument:IDENTIFIER ;

break_case = "break:" statement:break_statement trailing:INTEGER? ;
break_statement = "break" (BREAK_TERMINATOR_SPACE | BREAK_VALUE_SPACE value:INTEGER)? ;

extension_case = "ext:" first:IDENTIFIER EXTENSION_MEMBER_TERMINATOR second:IDENTIFIER ;
