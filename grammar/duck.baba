grammar Duck

// Contextual whitespace replaces Duck's external scanner with portable guards.
skip WHITESPACE = /[ \t\r\n]+/ ;
skip SEMICOLON = /;/ ;
skip comment = /\/\/[^\r\n]*/ ;
contextual _array_semicolon = /;/ ;
contextual _const_parameter = /const(?=$|[^A-Za-z0-9_])/ ;
contextual _application_space = /[ \t]+(?=[A-Za-z0-9"'(\[{#])(?!(as|by|else|if|in|is|where|with)\b)/ ;
contextual _block_space = /[ \t]+(?=\{)/ ;
contextual _condition_application_space = /[ \t]+(?=[A-Za-z0-9_"'(\[#])(?!(as|by|else|if|in|is|where|with)\b)/ ;
contextual _type_application_space = /[ \t]+(?=[A-Za-z_#&]|\(|\[)/ ;
contextual _break_value_space = /[ \t]+(?=[^\r\n;}])/ ;
contextual _break_terminator_space = /[ \t]+(?=$|[\r\n;}])/ ;
contextual _extension_member_terminator = /[\r\n][ \t]*/ ;
contextual _statement_terminator = /[\r\n][ \t]*/ ;
contextual FIXITY_BANG = /!(?=[ \t]*=)/ ;
contextual ARROW_PARAMETER priority 30 = /[A-Za-z_][A-Za-z0-9_]*(?=[ \t]*=>)/ ;
contextual ARROW_PARAMETER_LIST priority 30 = /\([ \t]*([^()\r\n]*[:!][^()\r\n]*|_[^()\r\n]*)\)(?=[ \t]*=>)/ ;
contextual BRACKET_PARAMETER_LIST = /\[[- A-Za-z0-9_,:!<>*&#().]*](?=[ \t]*=>)/ ;
contextual LINE_ARRAY_OPEN = /[\r\n][ \t]*\[/ ;
contextual TRAILING_PRODUCT_CLOSE = /,[ \t\r\n]*\)/ ;

token CONST priority 10 = /const/ ;
token CONST_VALUE_OPEN priority 60 = /#\(/ ;
token CONST_PARAMETER_LIST priority 30 = /\([^()\r\n]*const[^()\r\n]*\)/ ;
token EFFECT_BIND priority 60 = /<-/ ;
token EFFECT_BINDING priority 70 = /[A-Za-z_][A-Za-z0-9_]*[ \t]*<-/ ;
token MATCH priority 10 = /match/ ;
token HANDLER priority 70 = /\\andleK/ ;
token DISCARDED_ARROW priority 70 = /\\D~*/ ;
token SINGLE_ARROW_PARAMETER priority 70 = /\\[A-Za-z0-9_]*[ \t]*=[A-Za-z]/ ;
token FLOAT_LITERAL priority 70 = /\\[0-9]*[k-t][0-9]+f(32|64)/ ;
token HEX_LITERAL priority 70 = /\\H[0-9A-Fa-f]+/ ;
token CARET_OPERATOR priority 70 = /\\\^*C/ ;
token RECORD_SHAPE_HEAD priority 70 = /\\[ \t\r\n]*R/ ;
token TRAILING_ARRAY_CLOSE priority 70 = /\\[ \t\r\n]*A/ ;
token TRAILING_SHAPE_CLOSE priority 70 = /\\[ \t\r\n]*\}/ ;
token SHORTHAND_RECORD priority 70 = /\\[ \t\r\n]*[A-Za-z][A-Za-z0-9_]*([ \t\r\n]*,[ \t\r\n]*[A-Za-z][A-Za-z0-9_]*)+[ \t\r\n]*S/ ;
token MATCH_CASE_OPEN priority 20 = /[ \t]*\{[ \t\r\n]*\|/ ;
token NOT_EQUAL priority 60 = /!=/ ;
token UNION_ARRAY_OPEN priority 50 = /`[A-Z][A-Za-z0-9_]*[ \t]+\[/ ;
contextual UNION_WILDCARD = /`[A-Z][A-Za-z0-9_]*[ \t]+_/ ;
token grouped_value_alternative_pattern = /\([A-Za-z][A-Za-z0-9_]*([ \t\r\n]*\|[ \t\r\n]*[A-Za-z][A-Za-z0-9_]*)+\)/ ;
token identifier = /[A-Za-z][A-Za-z0-9_]*/ ;
token constructor_identifier = /[A-Z][A-Za-z0-9_]*/ ;
token intrinsic_identifier = /@[A-Za-z][A-Za-z0-9_.]*/ ;
token operator_symbol = /([-$%&*+>?@~:][.\-!$%&*+\/<=>?@|~:]*|\|[.\-!$%&*+\/<=>?@|~:]([.\-!$%&*+\/<=>?@|~:]*)?|<([.!$%&*+\/<=>?@|~:][.\-!$%&*+\/<=>?@|~:]*)?|\/([.\-!$%&*+<=>?@|~:][.\-!$%&*+\/<=>?@|~:]*)?|=[.\-!$%&*+\/<=>?@|~:][.\-!$%&*+\/<=>?@|~:]*)/ ;
token effect_identifier = /[A-Z][A-Za-z0-9]*/ ;
token row_variable = /[a-z_][A-Za-z0-9_]*/ ;
token number = /[0-9]+([iu][1-9][0-9]*|f(32|64))?/ ;
token string = /"([^"\\]|\\[ntr"\\])*"/ ;
token character = /'([^'\\\n\r]|\\[ntr'\\])'/ ;

source_file = module_header _module_statement* module_return_statement | _module_statement+ ;
module_header = "module" (parameters:parameter_list) "where" ;
_module_statement = attribute_group+ _attributed_module_statement | _attributed_module_statement | _plain_module_statement ;
_statement = attribute_group+ binding_statement | binding_statement | effect_binding_statement | type_pattern_statement | return_statement | for_statement | break_statement | continue_statement | expression_statement ;
binding_statement = ((kind:"let") ((recursive:"rec")?) | (kind:CONST) ((open:"open")?)) ((linear:"!")?) (name:_binding_pattern) ((":" (type:type_reference))?) "=" (value:_expression) ("and" (mutual_name:identifier) ((":" (mutual_type:type_reference))?) "=" (mutual_value:_expression))* (("else" (alternative:block))?) ;
effect_row = _effect_row_expression ;
_effect_row_expression = effect_union_expression ;
effect_union_expression = effect_intersection_expression (":|" effect_intersection_expression)* ;
effect_intersection_expression = effect_difference_expression (":&" effect_difference_expression)* ;
effect_difference_expression = _effect_row_primary (":-" _effect_row_primary)* ;
parenthesized_effect_expression = "(" (value:_effect_row_expression) ")" ;
effect_family_reference = effect:effect_identifier ;
effect_row_variable = name:row_variable ;
effect_operation_reference = (effect:effect_identifier) "." (operation:identifier) ;
effect_binding_statement = (head:EFFECT_BINDING) (value:_expression) | (name:unit_pattern) EFFECT_BIND (value:_expression) ;
resume_dup_statement = "let" "(" "!" (left:identifier) "," "!" (right:identifier) ")" "=" "dup" (value:linear_reference) ;
unit_pattern = "(" ")" ;
type_pattern_statement = "let" (pattern:type_pattern) "=" (value:_expression) ;
declare_effect_statement = "declare" "effect" (name:effect_identifier) (operations:effect_operation_block) ;
effect_statement = "effect" (name:effect_identifier) (parameter:identifier)* (operations:effect_operation_block) ;
effect_operation_block = "{" (effect_operation ((",")?))* (TRAILING_SHAPE_CLOSE | "}") ;
effect_operation = (("suspending")?) (name:identifier) ":" ((forall:effect_operation_forall)?) (parameters:host_parameter_list) "=>" (result:host_result) ;
effect_operation_forall = "forall" (parameter:identifier)+ "." ;
declare_record_statement = "declare" (name:identifier) (fields:type_field_block) ;
type_declaration_statement = "type" (name:identifier) (parameter:identifier)* "=" (definition:(type_sum | struct_type | newtype_type | packed_type | type_reference)) ;
newtype_type = "newtype" (representation:type_reference) ;
packed_type = "packed" (type_product | struct_type) ;
duck_declaration_statement = "duck" (name:identifier) (role:identifier)+ (members:duck_member_block) ;
duck_member_block = "{" ((duck_type_member | duck_member) ((",")?))+ (TRAILING_SHAPE_CLOSE | "}") ;
duck_type_member = "type" (name:identifier) (("=" (default:type_reference))?) ;
duck_member = "." (name:identifier) "=" (type:type_reference) ;
extension_declaration_statement = "extend" (type:identifier) (parameter:identifier)* (members:extension_member_block) ;
extension_member_block = "{" ((extension_type_member | shape_field) ("," | _extension_member_terminator))* ((extension_type_member | shape_field)?) (TRAILING_SHAPE_CLOSE | "}") ;
extension_type_member = "type" (name:identifier) "=" (type:type_reference) ;
fixity_declaration_statement = (fixity:("infixl" | "infixr" | "infix" | "prefix")) (precedence:number) (operator:(CARET_OPERATOR | operator_symbol | NOT_EQUAL | FIXITY_BANG)) "=" (target:fixity_target) ;
fixity_target = intrinsic_identifier "." identifier ("." identifier)* | qualified_identifier | identifier | intrinsic_identifier ;
qualified_identifier = identifier "." identifier ("." identifier)* ;
type_sum = type_case | "|" type_case ("|" type_case)+ ;
type_case = "`" (name:constructor_identifier) (payload:type_intersection) ;
type_product = positional_type_product ;
named_type_field = "." (name:identifier) "=" (type:type_reference) ;
positional_type_product = "(" (type_reference "," (type_reference ("," type_reference)*) ((",")?)) ")" | "(" (element:type_reference) _array_semicolon (length:(_expression | wildcard)) ")" | "[" ((type_reference ("," type_reference)* (TRAILING_ARRAY_CLOSE | "]")) | "]") ;
module_binding_statement = "module" (name:identifier) "=" (value:_expression) ;
host_parameter_list = "(" ((host_parameter ("," host_parameter)*)?) ")" ;
host_parameter = (contract:("&" | "#" | "scalar")) (type:type_reference) | type:type_reference ;
host_result = (contract:("#" | "scalar")) (type:type_reference) | type:type_reference ;
return_statement = "return" (value:_expression) ;
module_return_statement = "return" (exports:object_literal) ;
break_statement = "break" ((_break_terminator_space | _break_value_space (value:_expression))?) ;
continue_statement = "continue" ;
assignment = (name:identifier) (operator:("=" | ":=")) (value:_expression) ;
index_assignment = (name:identifier) "[" (index:_expression) "]" "=" (value:_expression) ;
for_statement = "for" (first:_match_pattern) (("," (second:_match_pattern))?) "in" (start_or_collection:condition_expression) (((".." | "..=") (end:condition_expression) (("by" (step:condition_expression))?))?) (body:block) | "for" (start:condition_expression) (".." | "..=") (end:condition_expression) (("by" (step:condition_expression))?) (body:block) ;
expression_statement = _expression ;
_expression = try_with_expression | arrow_function | recursive_expression | if_expression | loop_expression | effect_handler_expression | binary_expression ;
try_with_expression = "try" (body:_expression) (("with" (handler:_expression))?) ;
arrow_function = (parameters:(DISCARDED_ARROW | SINGLE_ARROW_PARAMETER)) (body:_expression) | (parameters:effect_identifier) "=>" (body:_expression) | (parameters:(ARROW_PARAMETER | ARROW_PARAMETER_LIST | const_parameter_list | bracket_parameter_list | unit_pattern | wildcard | number | string | character | boolean | grouped_value_alternative_pattern)) "=>" (body:_expression) ;
recursive_function = "rec" (parameters:(identifier | wildcard | ARROW_PARAMETER_LIST | parameter_list | const_parameter_list | bracket_parameter_list)) "=>" (body:_expression) ;
recursive_call_expression = "rec" (argument:positional_product) ;
parameter_list = "(" ((parameter ("," parameter)*)?) ")" ;
bracket_parameter_list = BRACKET_PARAMETER_LIST ;
parameter = (_const_parameter ((variadic:"...")?) | (linear:"!")?) (name:(identifier | wildcard)) ((":" (type:type_reference))?) ;
if_expression = "if" ("let" (pattern:_match_pattern) "=" (value:condition_expression) | "(" ("let" (pattern:_match_pattern) "=" (value:condition_expression)) ")" | condition:condition_expression) (consequence:block) (("else" (alternative:(block | if_expression)))?) ;
union_pattern = "`" (case:constructor_identifier) (value:(identifier | wildcard | unit_pattern | union_pattern | array_pattern | positional_product_pattern | named_product_pattern)) ;
condition_expression = condition_binary_expression ;
condition_binary_expression = condition_is_expression ((operator:(CARET_OPERATOR | operator_symbol | NOT_EQUAL)) (right:condition_is_expression))* ;
condition_is_expression = condition_unary_expression ((operator:"is") (type:type_reference))? ;
condition_unary_expression = "!" (operand:condition_unary_expression) | ((operator:("&" | "freeze" | "comptime" | "do" | CARET_OPERATOR | operator_symbol)) (operand:condition_unary_expression)) | condition_call_expression ;
condition_call_expression = condition_parenthesized_expression ((_condition_application_space (argument:(FLOAT_LITERAL | HEX_LITERAL | identifier | _aggregate_constructor_identifier | effect_identifier | intrinsic_identifier | number | string | character | boolean | atom_expression | import_meta_expression | linear_reference | parenthesized_or_product | array_expression))) | _condition_postfix_suffix)* ;
condition_application_expression = (function:(condition_application_expression | identifier | effect_identifier | intrinsic_identifier | condition_field_expression)) _condition_application_space (argument:(identifier | _aggregate_constructor_identifier | effect_identifier | intrinsic_identifier | number | string | character | boolean | atom_expression | import_meta_expression | linear_reference | parenthesized_or_product | array_expression)) ;
condition_field_expression = (object:condition_expression) "." (field:identifier) | (object:effect_identifier) "." (field:identifier) ;
condition_index_expression = (object:condition_expression) "[" (index:_expression) "]" ;
condition_parenthesized_expression = "(" condition_expression ")" | _condition_primary ;
binary_expression = is_expression ((operator:(CARET_OPERATOR | operator_symbol | NOT_EQUAL | "=" | ":=")) (right:is_expression))* ;
is_expression = as_expression ((operator:"is") (type:type_reference))? ;
as_expression = unary_expression (as_keyword (type:type_reference))* ;
unary_expression = "!" (operand:unary_expression) | ((operator:("&" | "freeze" | "comptime" | CARET_OPERATOR | operator_symbol)) (operand:unary_expression)) | application_expression ;
scratch_expression = "scratch" (body:block) ;
loop_expression = "loop" (body:block) ;
match_expression = MATCH (target:condition_expression) (cases:match_case_block) ;
match_case_block = MATCH_CASE_OPEN match_case_tail ((",")? match_case)* (TRAILING_SHAPE_CLOSE | "}") ;
match_case = "|" (pattern:_single_match_pattern) (_pattern_pipe (pattern:_single_match_pattern))* (("if" (guard:condition_expression))?) "=>" (body:_expression) ;
_match_pattern = alternative_pattern | _single_match_pattern ;
_binding_pattern = _binding_alternative_pattern | _single_binding_pattern ;
_binding_alternative_pattern = _single_binding_pattern (_pattern_pipe _single_binding_pattern)+ ;
_single_binding_pattern = const_value_pattern | union_pattern | number | string | character | boolean | identifier | _aggregate_constructor_identifier | wildcard | array_pattern | positional_product_pattern | named_shape_pattern ;
alternative_pattern = _single_match_pattern (_pattern_pipe _single_match_pattern)+ ;
_single_match_pattern = wildcard_union_pattern | const_value_pattern | type_pattern | union_pattern | number | string | character | boolean | identifier | _aggregate_constructor_identifier | wildcard | array_pattern | positional_product_pattern | named_shape_pattern ;
application_expression = postfix_expression ((_application_space (argument:(postfix_expression | field_block))) | (argument:(parenthesized_or_product | line_array_expression)))* ;
postfix_expression = _primary_expression _postfix_suffix* ;
field_expression = (object:postfix_expression) "." (field:identifier) | (object:effect_identifier) "." (field:identifier) ;
index_expression = (object:postfix_expression) "[" (index:_expression) "]" ;
struct_expression = (base:postfix_expression) (fields:field_block) ;
effect_handler_expression = HANDLER (effect:effect_identifier) (clauses:handler_clause_block) ;
handler_clause_block = "{" (handler_operation_clause ((",")?))* handler_return_clause (TRAILING_SHAPE_CLOSE | "}") ;
handler_operation_clause = (name:identifier) ":" (parameters:(ARROW_PARAMETER_LIST | parameter_list)) "=>" (body:_expression) ;
handler_return_clause = "return" ":" (value:_expression) ;
_primary_expression = FLOAT_LITERAL | HEX_LITERAL | number | string | character | boolean | "loop" | identifier | _aggregate_constructor_identifier | effect_identifier | intrinsic_identifier | atom_expression | import_meta_expression | import_expression | include_expression | named_product | positional_product | union_case | linear_reference | unit_pattern | line_array_expression | array_expression | array_repeat_expression | nonempty_field_block | match_expression | scratch_expression | block | parenthesized_expression ;
union_case = (head:UNION_ARRAY_OPEN) (value:union_array_payload) | "`" (case:constructor_identifier) _application_space (value:postfix_expression) ;
linear_reference = "!" (name:identifier) ;
atom_expression = "#" (name:row_variable) ;
import_meta_expression = "import" "." "meta" ;
import_expression = "import" (path:string) ;
include_expression = "include" (path:string) ;
struct_type = "struct" (fields:type_field_block) ;
named_product = "[" product_field ("," product_field)* (TRAILING_ARRAY_CLOSE | "]") ;
product_field = _named_product_dot (name:identifier) "=" (value:_expression) ;
positional_product = "(" (_expression "," (_expression ("," _expression)*)) (TRAILING_PRODUCT_CLOSE | ")") ;
parenthesized_or_product = unit_pattern | named_product | positional_product | parenthesized_expression ;
array_expression = "[" ((array_spread ("," _expression)* | _expression ("," _expression)* (("," array_spread))?) (TRAILING_ARRAY_CLOSE | "]") | "]") ;
array_spread = "..." (value:_expression) ;
array_repeat_expression = "[" (value:_expression) _array_semicolon (length:_expression) "]" ;
array_pattern = "[" ((_array_pattern_element ("," _array_pattern_element)*) (TRAILING_ARRAY_CLOSE | "]") | "]") ;
_array_pattern_element = identifier | wildcard | union_pattern | array_pattern | positional_product_pattern | named_product_pattern | array_rest_pattern ;
array_rest_pattern = "..." (name:(identifier | wildcard)) ;
positional_product_pattern = "(" (_match_pattern "," (product_rest_pattern | _match_pattern ("," _match_pattern)*)) ")" ;
value_pack_split_pattern = "(" (first:(identifier | wildcard)) "," (rest:product_rest_pattern) ")" ;
product_rest_pattern = "..." (name:(identifier | wildcard)) ;
named_product_pattern = "[" (named_product_pattern_field ("," named_product_pattern_field)*) "]" ;
named_product_pattern_field = _named_product_dot (name:identifier) "=" (pattern:_match_pattern) ;
named_shape_pattern = "{" (((shorthand_shape_pattern_field | named_shape_pattern_field) ("," (shorthand_shape_pattern_field | named_shape_pattern_field))*)?) (TRAILING_SHAPE_CLOSE | "}") ;
function_shape_pattern = "{" ((function_shape_pattern_field ("," function_shape_pattern_field)*)?) (TRAILING_SHAPE_CLOSE | "}") ;
function_shape_pattern_field = (name:identifier) ((":" (type:type_reference))?) ;
shorthand_shape_pattern_field = name:identifier ;
named_shape_pattern_field = "." (name:identifier) (("=" (pattern:_match_pattern))?) ;
object_literal = fields:field_block ;
field_block = "{" (((shape_field | field_definition | shorthand_field) ("," (shape_field | field_definition | shorthand_field))*)?) (TRAILING_SHAPE_CLOSE | "}") | RECORD_SHAPE_HEAD first_shape_field ("," (shape_field | field_definition | shorthand_field))* (TRAILING_SHAPE_CLOSE | "}") | SHORTHAND_RECORD ;
shape_field = "." (name:identifier) "=" (value:_expression) ;
computed_shape_field = "." "[" (name:_expression) "]" "=" (value:_expression) ;
field_definition = (name:identifier) ":" (value:arrow_function) ;
shorthand_field = name:identifier ;
type_field_block = "{" ((type_field | named_type_field) ((",")?))* (TRAILING_SHAPE_CLOSE | "}") ;
type_field = (name:identifier) ":" (type:identifier) ;
type_pattern = (kind:("struct" | "union")) "{" (type_pattern_field ",")* ((type_pattern_field | open:"..")?) (TRAILING_SHAPE_CLOSE | "}") ;
type_pattern_field = "." (name:identifier) "=" (type:type_reference) ;
block = "{" _statement* "}" ;
parenthesized_expression = "(" _expression ")" ;
type_reference = _type_expression ;
_type_expression = forall_type | function_type ;
forall_type = "forall" (parameter:identifier)+ "." (body:_type_expression) ;
function_type = type_union (("->" (effects:latent_effect_row)? (result:_type_expression)))? ;
type_union = type_intersection (":|" type_intersection)* ;
type_intersection = type_difference (":&" type_difference)* ;
type_difference = type_application (":-" type_application)* ;
latent_effect_row = "<" (row:effect_row) ">" ;
_type_application = type_application ;
type_application = _type_prefix ((_type_application_space (argument:_type_prefix)) | (argument:type_parenthesized))* ;
_type_prefix = atom_type | frozen_type | borrow_type | _type_atom ;
atom_type = "#" (name:row_variable) ;
frozen_type = "#" (name:effect_identifier | type_parenthesized) ;
borrow_type = "&" (identifier | type_parenthesized) ;
_type_atom = effect_identifier | identifier | top_type | never_type | type_literal | unit_type | type_parenthesized | type_product | array_type ;
type_literal = number | string | character | boolean ;
unit_type = "(" ")" ;
top_type = "_" ;
never_type = "Never" ;
array_type = "[" (element:_type_expression) _array_semicolon (length:(_expression | wildcard)) "]" ;
type_parenthesized = "(" (value:_type_expression) ")" ;
wildcard = "_" ;
_aggregate_constructor_identifier = "struct" ;
_named_product_dot = "." ;
_pattern_pipe = "|" ;
as_keyword = "as" ;
attribute_group = "@" "[" (_expression ("," _expression)*) (TRAILING_ARRAY_CLOSE | "]") ;
boolean = "true" | "false" ;
const_value_pattern = CONST_VALUE_OPEN (value:_expression) ")" ;
first_shape_field = (name:identifier) "=" (value:_expression) ;
line_array_expression = LINE_ARRAY_OPEN ((product_field ("," product_field)* | (array_spread ("," _expression)* | _expression ("," _expression)* (("," array_spread))?)) (TRAILING_ARRAY_CLOSE | "]") | "]") ;
union_array_payload = ((product_field ("," product_field)* | (array_spread ("," _expression)* | _expression ("," _expression)* (("," array_spread))?)) (TRAILING_ARRAY_CLOSE | "]") | "]") ;
wildcard_union_pattern = UNION_WILDCARD ;
recursive_expression = "rec" (operand:(identifier | wildcard | ARROW_PARAMETER_LIST | positional_product | const_parameter_list | bracket_parameter_list)) (("=>" (body:_expression))?) ;
_attributed_module_statement = declare_effect_statement | effect_statement | declare_record_statement | type_declaration_statement | duck_declaration_statement | extension_declaration_statement | fixity_declaration_statement | module_binding_statement | binding_statement ;
_plain_module_statement = effect_binding_statement | type_pattern_statement | for_statement | break_statement | continue_statement | expression_statement ;
_effect_row_primary = parenthesized_effect_expression | effect_family_reference | effect_row_variable | effect_operation_reference ;
_postfix_suffix = "." (field:identifier) | "[" (index:_expression) "]" | handler_clause_block ;
_condition_primary = FLOAT_LITERAL | HEX_LITERAL | number | string | character | boolean | atom_expression | import_meta_expression | intrinsic_identifier | "loop" | identifier | _aggregate_constructor_identifier | effect_identifier | linear_reference | union_case ;
_condition_postfix_suffix = argument:parenthesized_or_product | "." (field:identifier) | "[" (index:_expression) "]" ;
binding_product_pattern = "(" (_binding_pattern "," (_binding_pattern ("," _binding_pattern)*)) ")" ;
linear_binding_pattern = "!" (name:identifier) ;
const_parameter_list = CONST_PARAMETER_LIST ;
match_case_tail = (pattern:_single_match_pattern) (_pattern_pipe (pattern:_single_match_pattern))* (("if" (guard:condition_expression))?) "=>" (body:_expression) ;
nonempty_field_block = RECORD_SHAPE_HEAD (first_shape_field | shorthand_field) ("," (shape_field | field_definition | shorthand_field))* (TRAILING_SHAPE_CLOSE | "}") | SHORTHAND_RECORD ;
