token IDENT = /[A-Za-z_][A-Za-z0-9_]*/ ;
token INTEGER = /[0-9]+/ ;
skip WS = /[ \t\r\n]+/ ;
skip COMMENT = /\/\/[^\n]*/ ;

module = functions:function+ ;

function = "fn" name:IDENT "(" parameters:parameter_list? ")" "=" body:expr ";" ;
parameter_list = head:IDENT tail:parameter_tail* ;
parameter_tail = "," value:IDENT ;

expr = let_expr | if_expr | repeat_expr | comparison ;
let_expr = "let" name:IDENT "=" value:expr "in" body:expr ;
if_expr = "if" condition:expr "then" consequent:expr "else" alternate:expr ;
repeat_expr = "repeat" count:expr "from" initial:expr "as" name:IDENT "{" body:expr "}" ;

comparison = left:additive rest:comparison_tail* ;
comparison_tail = op:comparison_op right:additive ;
comparison_op = eq | ne | lt | le | gt | ge ;
eq = "==" ;
ne = "!=" ;
lt = "<" ;
le = "<=" ;
gt = ">" ;
ge = ">=" ;

additive = left:multiplicative rest:additive_tail* ;
additive_tail = op:additive_op right:multiplicative ;
additive_op = plus | minus ;
plus = "+" ;
minus = "-" ;

multiplicative = left:call rest:multiplicative_tail* ;
multiplicative_tail = op:multiplicative_op right:call ;
multiplicative_op = star | slash | remainder ;
star = "*" ;
slash = "/" ;
remainder = "%" ;

call = callee:primary arguments:call_arguments? ;
call_arguments = "(" values:argument_values? ")" ;
argument_values = head:expr tail:argument_tail* ;
argument_tail = "," value:expr ;

primary = integer | variable | group ;
integer = value:INTEGER ;
variable = name:IDENT ;
group = "(" body:expr ")" ;
