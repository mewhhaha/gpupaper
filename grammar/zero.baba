token VISIBILITY = /export:|private:/ ;
token IDENT = /[A-Za-z_][A-Za-z0-9_]*/ ;
token INSTRUCTION = /@[A-Za-z_][A-Za-z0-9_]*|let:[A-Za-z_][A-Za-z0-9_]*|call:[A-Za-z_][A-Za-z0-9_]*:[0-9]+|repeat:[A-Za-z_][A-Za-z0-9_]*|select!|[0-9]+|==|!=|<=|>=|[+*\/%<>-]/ ;
skip WS = /[ \t\r\n]+/ ;
skip COMMENT = /\/\/[^\n]*/ ;

module = functions:function+ ;
function = visibility:VISIBILITY name:IDENT parameters:IDENT* "=" body:INSTRUCTION+ ";" ;
