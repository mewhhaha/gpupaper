grammar Blot

// Every token has one fixed terminal identity: no layout sensitivity, no
// template islands, no contextual promotion. That is requirement 2 of baba's
// version-3 GPU frontend profile, and it is the constraint the whole language
// is designed around.

token IDENT = /[a-z_][A-Za-z0-9_]*/ ;
token TYPE_IDENT = /[A-Z][A-Za-z0-9_]*/ ;
token INTEGER = /[0-9]+/ ;
token TEXT = /"([^"\\]|\\[ntr"\\])*"/ ;
token ELSE_IF priority 3 = /else[ \t\r\n]+if/ ;
token INTRINSIC priority 3 = /@[a-z_][A-Za-z0-9_]*(\.[a-z_][A-Za-z0-9_]*)*/ ;

// One operator class rather than an enumerated set. Custom operators are
// therefore lexically ordinary; precedence and meaning come from the
// `operators` header and are resolved semantically by fold-fixity, never by
// grammar recursion.
//
// An operator may contain `/` anywhere except as a doubled prefix, which is
// what keeps `/` available for division while `//` stays unambiguously a
// comment. Spelled out rather than as `[...]+` because the lexer requires
// disjoint terminal identities, not a longest-match tiebreak.
token OPERATOR =
  /[+\-*<>=|&^%!?~$:\\][+\-*\/<>=|&^%!?~$:\\]*|\/[+\-*<>=|&^%!?~$:\\][+\-*\/<>=|&^%!?~$:\\]*|\// ;

skip WHITESPACE = /[ \t\r\n]+/ ;
skip COMMENT = /\/\/[^\r\n]*/ ;

// A module is a block: bounded headers, then one repeated `;`-terminated
// island. `return` is a declaration form rather than a trailing bare
// expression so that the strict root loop stays provable.
program = (
  header:module_header?
  operators:operator_section?
  declarations:declaration+
) ;

module_header = (
  "module"
  parameter:binding_pattern
  ";"
) ;

operator_section = (
  "operators"
  "{"
  declarations:fixity_declaration*
  "}"
  ";"
) ;

fixity_declaration = (
  associativity:("infixl" | "infixr" | "infix" | "prefix")
  precedence:INTEGER
  "("
  operator:OPERATOR
  ")"
  "="
  target:qualified_name
  ";"
) ;

// `type`, `interface`, `effect`, `duck`, and every other binder in the
// reference language collapse into `const`, because types are ordinary
// compile-time values.
declaration =
  binding | rebinding | opening | iteration | breaking
  | conditional_statement | result ;

// `statement` is `declaration` under a second name. The duplication is
// mechanical and exists only so that `declaration` is not self-nesting, which
// is what "throughput": "strict" requires of the repeated root island.
statement =
  binding | rebinding | opening | iteration | breaking
  | conditional_statement | result ;

binding = (
  kind:("let" | "const" | "sig")
  pattern:binding_pattern
  "="
  value:value
  ";"
) ;

// Rebinding a name. Two arrows, one rule: `:=` shadows an existing binding with
// a value of the same stable type, while `<-` binds the result of a computation
// that performs. A new `let` or `const` is how a name is shadowed with another
// type.
//
// One rule rather than two alternatives because they share their FIRST set — a
// name — and splitting them is a shift/reduce conflict on IDENT. Factoring the
// arrow out is the design fix, and it says something true: both are a name, an
// arrow, and a value, and neither takes a pattern.
//
// `<-` is not a second spelling for `let`. It is admitted only where the
// value's row is non-empty, and it applies a nullary operation, so
// `input <- Terminal.read` needs no `()`.
rebinding = (
  name:(IDENT | TYPE_IDENT)
  arrow:(":=" | "<-")
  value:value
  ";"
) ;

// Looping. A declaration rather than an expression, because what a loop
// produces is an effect on the enclosing scope: the names its body rebinds
// with `:=` are the accumulator, and the last iteration's are what escape.
// That is a fold with the state inferred, which is why blot can have `for`
// without having assignment.
//
//   for source do … end;              runs the body once per element
//   for x in source do … end;         binds each element
//   for #Some x in source do … end;   binds, and skips what does not match
//
// `break` stops the nearest `for` with its accumulator as it exists at that
// point. An unbounded loop is an ordinary iteration over an infinite iterator:
// `for ever do … end;`.
iteration = (
  "for"
  head:value
  drawn:iteration_source?
  "do"
  body:statement*
  "end"
  ";"
) ;

// `head` is parsed as a value and reclassified into a pattern when `in`
// follows — the same trick `lambda` uses for its parameter. Making the binder a
// separate alternative would need the parser to decide between a pattern and an
// expression from the first token, which they share; deciding after `in` costs
// nothing and keeps the FIRST sets disjoint.
//
// A keyword rather than an arrow, so `<-` stays in the operator class and is
// free for perform-binding an effect.
iteration_source = ( "in" source:value ) ;

breaking = (
  "break"
  ";"
) ;

// Spreading a module's exports into scope, with an optional rename/ignore mask.
// Fields absent from the mask keep their names, `.source: target` renames one,
// and `.source: _` suppresses one. The prelude is an ordinary module with no
// privilege, so this is how `+` finds `Num.add` — a default fixity whose target
// is not in scope is useless, and `open` is what puts it there.
opening = (
  "open"
  mask:open_mask
  "="
  value:value
  ";"
) ;

open_mask = (
  "{"
  entries:(open_mapping % ",")?
  "}"
) ;

open_mapping = (
  "."
  source:field_name
  ":"
  target:(IDENT | TYPE_IDENT)
) ;

result = (
  "return"
  value:value
  ";"
) ;

// Patterns. The qualifier carries `!` (linear, consumed exactly once) and `&`
// (bounded borrow), and absorbs `-` so that negative literal patterns need no
// separate rule. It is OPERATOR rather than a set of literals because spelling
// those as literals would shadow them out of the operator class entirely,
// costing every custom operator that uses those characters.
binding_pattern = (
  qualifier:OPERATOR?
  value:pattern_core
) ;

// TYPE_IDENT binds like any other name: types are values, so `const I32 = ...`
// is an ordinary binding and the capitalization is convention, not syntax.
// Constructors always carry `#`, so a bare TYPE_IDENT is never a match.
// `_` is deliberately absent as a literal: it also matches IDENT, so a parser
// would have to choose between the two by context, and requirement 2 of the GPU
// profile forbids contextual terminal identity. `_` is an ordinary name that
// lowering treats as a wildcard, which costs nothing — a binding nobody reads
// is exactly what a wildcard is.
pattern_core = (
  IDENT
  | TYPE_IDENT
  | INTEGER
  | TEXT
  | unit_pattern
  | tuple_pattern
  | array_pattern
  | constructor_pattern
  | shape_pattern
) ;

unit_pattern = ("(" ")") ;

tuple_pattern = (
  "("
  first:binding_pattern
  ","
  rest:(binding_pattern % ",")
  ")"
) ;

array_pattern = (
  "["
  elements:(binding_pattern % ",")?
  "]"
) ;

constructor_pattern = (
  "#"
  constructor:TYPE_IDENT
  payload:binding_pattern?
) ;

// Shape patterns terminate members with `;`, matching shape construction.
shape_pattern = (
  "{"
  fields:shape_pattern_field*
  "}"
) ;

shape_pattern_field = (
  "."
  name:field_name
  value:("=" binding_pattern)?
  ";"
) ;

// Expressions are flat operand/operator chains. Precedence is a semantic
// recipe, so the contracted grammar has no residual recursion here.
expression = (
  first:operand
  rest:infix_operation*
) ;

infix_operation = (
  operator:OPERATOR
  right:operand
) ;

// Spelled as two alternatives rather than `prefix_operator* postfix_expression`
// so that no empty-repetition reduction has to be decided before the parser
// knows whether it is inside a lambda parameter or an expression.
operand = (
  postfix_expression
  | prefixes:prefix_operator+ value:postfix_expression
) ;

// `...` is deliberately absent: spreading is only meaningful in array and
// shape positions, and having it in both places made the two readings of
// `[...x]` ambiguous.
prefix_operator = (OPERATOR | "comptime" | "rec") ;

// Unary application by juxtaposition: `f x y` is `(f x) y`. This matches
// gpufuck's unary Core exactly, so lowering needs no currying pass.
postfix_expression = (
  value:primary_expression
  suffixes:field_suffix*
  arguments:application_argument*
) ;

application_argument = (
  value:application_primary
  suffixes:field_suffix*
) ;

field_suffix = ("." field:field_name) ;

// Field names accept every keyword and TYPE_IDENT. blot has few keywords, but
// `.const`, `.type`, `.of`, and `.end` are all natural member names, and types
// are values so `.I32` and `.Num` are ordinary members too. Enumerating the
// keyword set here is static — it needs no contextual token, which the GPU
// profile forbids outright.
field_name = (IDENT | TYPE_IDENT | INTEGER | keyword) ;

keyword = (
  "module" | "operators" | "infixl" | "infixr" | "infix" | "prefix"
  | "let" | "const" | "sig" | "return" | "do" | "end"
  | "if" | "then" | "else" | "case" | "of" | "rec" | "comptime" | "open"
  | "for" | "in" | "break" | "try"
) ;

primary_expression = (
  IDENT
  | TYPE_IDENT
  | INTEGER
  | TEXT
  | INTRINSIC
  | constructor_expression
  | unit
  | conditional
  | case_expression
  | handler_composition
  | block
  | array
  | shape
  | parenthesized_or_tuple
) ;

application_primary = (
  IDENT
  | TYPE_IDENT
  | INTEGER
  | TEXT
  | INTRINSIC
  | constructor_expression
  | unit
  | array
  | shape
  | parenthesized_or_tuple
) ;

constructor_expression = (
  "#"
  constructor:TYPE_IDENT
) ;

unit = ("(" ")") ;

parenthesized_or_tuple = (
  "("
  first:value
  tail:("," rest:(value % ","))?
  ")"
) ;

array = (
  "["
  elements:(array_element % ",")?
  "]"
) ;

array_element = (
  spread:"..."?
  value:value
) ;

// A lambda is admissible wherever a value is. Without this, `=>` still lexes
// as an ordinary OPERATOR — every character in it is in the operator class —
// so `(x => x)` would quietly parse as an infix chain instead of failing.
value = lambda | expression ;

// One structural aggregate. Tuples are shapes with integer labels; the
// reference language's stored-tuple versus transient-pack distinction is gone.
shape = (
  "{"
  members:shape_member*
  "}"
) ;

shape_member = shape_spread | shape_field ;

shape_spread = (
  "..."
  value:expression
  ";"
) ;

shape_field = (
  "."
  name:field_name
  "="
  value:value
  ";"
) ;

// One parameter, sharing the `postfix_expression` prefix with an ordinary
// operand so that the parser never has to choose between "pattern" and
// "expression" before it sees `=>`. Semantic analysis reclassifies the head as
// a pattern and rejects heads that are not valid ones.
//
// Currying therefore needs parentheses: `f => (x => f (f x))`. That is the
// honest cost of a locatable island boundary, and it is a small one in a
// language where the idiomatic multi-argument function takes one shape.
lambda = (
  parameter:postfix_expression
  "=>"
  body:expression
) ;

conditional = (
  "if"
  condition:expression
  "then"
  consequence:value
  alternatives:else_if_clause*
  fallback:else_clause
  "end"
) ;

else_if_clause = (
  ELSE_IF
  condition:expression
  "then"
  consequence:value
) ;

else_clause = (
  "else"
  alternative:value
) ;

// A standalone conditional is control flow in the surrounding body rather
// than a value. Its branches contain statements, so `return` and `break` may
// target the surrounding function or loop. `else` is optional because the
// normal result is always `()`.
//
// `then do` introduces the branch body rather than nesting an expression block,
// so one `end;` closes the whole statement:
//
//   if ready then do
//     return ();
//   end;
conditional_statement = (
  "if"
  body:(conditional_statement_guard | conditional_statement_branches)
  "end"
  ";"
) ;

// A deconstructing guard has no success block: matching binds the pattern for
// the statements that follow it, while the `else` body must transfer control.
//
//   if let #Some value = option else do
//     return fallback;
//   end;
//   // value is in scope here
conditional_statement_guard = (
  "let"
  pattern:binding_pattern
  "="
  value:value
  "else"
  "do"
  alternative:statement*
) ;

conditional_statement_branches = (
  condition:expression
  "then"
  "do"
  consequence:statement*
  alternatives:conditional_statement_else_if_clause*
  fallback:conditional_statement_else_clause?
) ;

conditional_statement_else_if_clause = (
  ELSE_IF
  condition:expression
  "then"
  "do"
  consequence:statement*
) ;

conditional_statement_else_clause = (
  "else"
  "do"
  alternative:statement*
) ;

case_expression = (
  "case"
  target:expression
  "of"
  first:case_arm
  rest:("," case_arm)*
  "end"
) ;

case_arm = (
  pattern:binding_pattern
  "=>"
  body:value
) ;

// Compose statically known handlers around one nullary computation. Each
// bound step receives the computation produced by handling the previous
// effect; the final step executes the fully composed computation.
//
// `@handle` remains the only handling primitive. Its two-argument appearance
// is confined to this bounded surface form, where the current computation is
// the omitted middle argument. Lowering restores the ordinary
// `@handle (effect, computation, handler)` call before inference.
handler_composition = (
  "try"
  program:value
  "then"
  "do"
  steps:handler_composition_step*
  result:handler_composition_action
  "end"
) ;

handler_composition_step = (
  name:(IDENT | TYPE_IDENT)
  "<-"
  action:handler_composition_action
  ";"
) ;

handler_composition_action = (
  intrinsic:INTRINSIC
  "("
  effect:value
  ","
  handler:value
  ")"
) ;

// `in` separates a block's value from its semicolon-terminated statements.
// Without it, an IDENT after a statement could be either the tail value or the
// beginning of `name := value;`, which is an LR conflict and therefore not a
// strict GPU island. A block without `in` produces `()`.
block = (
  "do"
  statements:statement*
  result:("in" value)?
  "end"
) ;

qualified_name = (
  root:(IDENT | TYPE_IDENT | INTRINSIC)
  rest:qualified_name_part*
) ;

qualified_name_part = ("." name:field_name) ;
